# Le variabili d'ambiente lette dal backend. Si copia in backend/.env e si
# riempie; i segreti restano vuoti qui e non vanno mai committati.

# Database applicativo (obbligatoria: senza, il backend non parte).
DATABASE_URL=postgresql://<utente>:<password>@localhost:5432/gantt_db
# Database dei test pytest: deve chiamarsi gantt_test, o i test si fermano.
DATABASE_URL_TEST=postgresql://<utente>:<password>@localhost:5432/gantt_test

# Chiave che firma i token di sessione (obbligatoria). Generala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Algoritmo di firma dei token. Assente: HS256.
JWT_ALGORITHM=HS256
# Durata della sessione in ore, per il token e per il cookie. Assente: 8.
JWT_EXPIRE_HOURS=8
# Emittente scritto nel token e verificato in lettura. Assente: imc-gantt.
JWT_ISSUER=imc-gantt

# Nome del cookie di sessione. Assente: imc_session.
COOKIE_NAME=imc_session
# Cookie solo su HTTPS: True in produzione, False in sviluppo su http. Assente: False.
COOKIE_SECURE=False
# Politica SameSite del cookie (lax, strict, none). Assente: lax.
COOKIE_SAMESITE=lax

# Porta del backend: la leggono il backend, Vite (proxy /api) e gli e2e. Assente: 8100.
GANTT_PORTA_BACKEND=8100
# Porta del frontend: la leggono Vite, il CORS del backend e gli e2e. Assente: 3100.
GANTT_PORTA_FRONTEND=3100
# Origini ammesse dal CORS, separate da virgola. Assente: http://localhost:<GANTT_PORTA_FRONTEND>. Vuota: nessuna (produzione, stesso dominio).
# GANTT_ORIGINI_CORS=

# Chiave dell'API Gemini (Google AI Studio), per le chiamate all'IA.
GEMINI_API_KEY=
# Modello Gemini, senza default nel codice: se manca, fallisce solo la richiesta all'IA.
GEMINI_MODEL=gemini-3.7-flash
